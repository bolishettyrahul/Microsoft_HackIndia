# Copy to .env and fill in. .env is gitignored; never commit keys.
GROQ_API_KEY=
GEMINI_API_KEY=
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Comma-separated model ids, in handoff order.
BATON_MODEL_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,groq:qwen/qwen3.8-27b
BATON_EXTRACTOR_CHAIN=groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite

# real: the backend uses the AI sector. fake: the backend uses in-memory fake AI (no keys needed).
BATON_AI=real
BATON_DB_PATH=baton.db
BATON_HISTORY_WINDOW=6

# Generate a private URL token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If omitted, a random token is generated for this server process (changes on restart).
BATON_MCP_TOKEN=
# Optional HTTPS origin from a tunnel, without a trailing /mcp path.
BATON_PUBLIC_URL=
